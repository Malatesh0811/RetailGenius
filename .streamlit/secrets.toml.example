# Copy this file to .streamlit/secrets.toml and put your real key in it.
# secrets.toml is listed in .gitignore, so it never gets pushed to GitHub.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY = "gsk_your_key_here"

# Optional: which Groq model the SQL agent uses (default: openai/gpt-oss-120b).
# List the models your key can use: https://console.groq.com/docs/models
# GROQ_MODEL = "openai/gpt-oss-120b"
